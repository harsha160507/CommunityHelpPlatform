{
  "name": "community-help-platform",
  "version": "2.0.0",
  "private": true,
  "description": "Community events, NGO review and volunteer participation",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node --watch backend/src/server.js",
    "migrate": "node backend/scripts/migrate.js",
    "admin:setup": "node backend/scripts/admin.js",
    "mail:preview": "node backend/scripts/mail-preview.js",
    "check": "node scripts/check.js",
    "test": "node --test tests/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "lint": "eslint backend frontend scripts tests eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "luxon": "^3.5.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^10.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0"
  },
  "license": "UNLICENSED"
}
