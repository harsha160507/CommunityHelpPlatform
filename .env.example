NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000
EVENT_TIMEZONE=Asia/Kolkata
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=community_help
DB_PASSWORD=
DB_NAME=community_help
# Production: configure SMTP before starting. Use a TLS reverse proxy.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Development only: inspect local queued messages with npm run mail:preview.
DEV_MAIL_PREVIEW=true
# Supply explicitly ONLY when running npm run admin:setup. Never commit real values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to 1 only behind exactly one trusted reverse proxy; otherwise leave 0.
TRUST_PROXY=0
